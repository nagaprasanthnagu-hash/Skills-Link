# Copy this file to .env and fill in real values before running in production.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Leave EMAIL_HOST blank to keep OTP emails printing to the console when
# running with DJANGO_SETTINGS_MODULE=config.settings.development (default,
# zero-config academic demo). Fill in real SMTP details below to have OTP
# emails delivered to an actual inbox instead — works the same way in both
# development and production.
DEFAULT_FROM_EMAIL=no-reply@serviceprovided.local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # optional override
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
